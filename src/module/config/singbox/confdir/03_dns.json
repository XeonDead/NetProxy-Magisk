{
  "dns": {
    "servers": [
      {
        "tag": "yandex",
        "type": "udp",
        "server": "77.88.8.8"
      },
      {
        "tag": "google",
        "type": "udp",
        "server": "8.8.4.4",
        "detour": "Proxy"
      },
      {
        "tag": "remote",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      },
      {
        "tag": "malw-hosts",
        "type": "hosts",
        "path": [
          "./source/malw-dns.hosts"
        ]
      }
    ],
    "rules": [
      {
        "action": "evaluate",
        "server": "malw-hosts"
      },
      {
        "match_response": true,
        "ip_accept_any": true,
        "action": "respond"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "yandex"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "server": "google"
      },
      {
        "domain": [
          "cloudflare-ech.com"
        ],
        "action": "route",
        "server": "yandex"
      },
      {
        "rule_set": [
          "direct"
        ],
        "action": "route",
        "server": "yandex"
      },
      {
        "rule_set": [
          "Proxy"
        ],
        "action": "route",
        "server": "google"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "AllowAds",
            "invert": true
          },
          {
            "rule_set": [
              "block",
              "hagezi-pro-adlist"
            ]
          }
        ],
        "action": "reject",
        "response_rcode": "success"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "remote"
      }
    ],
    "strategy": "ipv4_only",
    "cache_capacity": 2048,
    "optimistic": {
      "enabled": true,
      "timeout": "1d"
    }
  }
}
