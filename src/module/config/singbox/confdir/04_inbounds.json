{
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed_in",
      "listen": "::",
      "listen_port": 7080
    }
  ],
  "route": {
    "rules": [
      {
        "action": "resolve",
        "strategy": "prefer_ipv4",
        "rewrite_ttl": 300,
        "timeout": "300s"
      },
      {
        "action": "sniff",
        "timeout": "1s"
      }
    ]
  }
}
