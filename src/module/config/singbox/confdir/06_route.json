{
  "route": {
    "default_http_client": "rule-set-download",
    "default_domain_resolver": "yandex",
    "rule_set": [
      {
        "tag": [
          "block",
          "direct",
          "proxy"
        ],
        "type": "local",
        "format": "source",
        "path": "./rules/local/{tag}.json"
      },
      {
        "tag": "hagezi-pro-adlist",
        "type": "remote",
        "format": "binary",
        "url": "https://github.com/zxc-rv/ad-filter/releases/latest/download/adlist.srs",
        "http_client": "rule-set-download",
        "update_interval": "24h",
        "path": "./rules/remote/hagezi-pro-adlist.srs"
      },
      {
        "tag": "geoip-ru",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/refs/heads/rule-set/geoip-ru.srs",
        "http_client": "rule-set-download",
        "update_interval": "24h",
        "path": "./rules/remote/geoip-ru.srs"
      },
      {
        "tag": "geosite-ru",
        "type": "local",
        "format": "binary",
        "path": "./rules/local/zapret-ru-domains.srs"
      }
    ],
    "rules": [
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "action": "sniff-override-destination"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "ip_cidr": [
          "198.18.0.0/15",
          "fc00::/18"
        ],
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": [
          "direct"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "proxy"
        ],
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "protocol": [
          "bittorrent"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "AllowAds",
            "invert": true
          },
          {
            "rule_set": [
              "block",
              "hagezi-pro-adlist"
            ]
          }
        ],
        "action": "reject"
      },
      {
        "domain_suffix": [
          "local",
          "lan"
        ],
        "outbound": "direct-out"
      },
      {
        "action": "resolve",
        "match_only": true,
        "strategy": "prefer_ipv4",
        "server": "google"
      },
      {
        "rule_set": [
          "geoip-ru",
          "geosite-ru"
        ],
        "action": "route",
        "outbound": "direct"
      }
    ],
    "find_process": true,
    "final": "Proxy"
  }
}
