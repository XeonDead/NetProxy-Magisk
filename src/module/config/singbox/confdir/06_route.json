{
  "route": {
    "default_http_client": "rule-set-download",
    "default_domain_resolver": "agh-local",
    "rule_set": [
      {
        "tag": [
          "block",
          "direct",
          "proxy"
        ],
        "type": "local",
        "format": "source",
        "path": "./rules/local/{tag}.json"
      },
      {
        "tag": "geoip-ru",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/refs/heads/rule-set/geoip-ru.srs",
        "http_client": "rule-set-download",
        "update_interval": "24h",
        "path": "./rules/remote/geoip-ru.srs"
      },
      {
        "tag": "geosite-ru",
        "type": "local",
        "format": "binary",
        "path": "./rules/local/zapret-ru-domains.srs"
      }
    ],
    "rules": [
      {
        "process_name": [
          "AdGuardHome",
          "adguardhome"
        ],
        "outbound": "direct"
      },
      {
        "action": "sniff-override-destination"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": "proxy",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": "direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "protocol": [
          "bittorrent"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          "local",
          "lan"
        ],
        "outbound": "direct-out"
      },
      {
        "action": "resolve",
        "match_only": true,
        "strategy": "prefer_ipv4",
        "server": "agh-local"
      },
      {
        "rule_set": [
          "geoip-ru",
          "geosite-ru"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      }
    ],
    "auto_detect_interface": true,
    "final": "Proxy"
  }
}
