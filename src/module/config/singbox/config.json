{
  "$schema": "https://raw.githubusercontent.com/reF1nd/sing-box/reF1nd-testing-next/docs/schema.json",
  "log": {
    "disabled": false,
    "level": "warn",
    "output": "/data/adb/modules/netproxy/logs/sing-box.log",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/data/adb/modules/netproxy/config/singbox/cache.db"
    },
    "clash_api": {
      "default_mode": "Rule",
      "external_controller": "127.0.0.1:9999",
      "secret": "singbox",
      "external_ui": "/data/adb/modules/netproxy/webroot/zashboard",
      "external_ui_download_url": "https://github.com/MetaCubeX/metacubexd/releases/download/latest/compressed-dist.tgz"
    }
  },
  "services": [
    {
      "type": "api",
      "listen": "127.0.0.1",
      "listen_port": 9090,
      "secret": "singbox",
      "dashboard": {
        "enabled": true,
        "path": "/data/adb/modules/netproxy/webroot/sing-box-dashboard",
        "http_client": "s-download"
      }
    }
  ],
  "http_clients": [
    {
      "tag": "s-download",
      "detour": "Proxy"
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "agh-local",
        "type": "udp",
        "server": "127.0.0.1",
        "server_port": 5591
      }
    ],
    "rules": [
      {
        "action": "route",
        "server": "agh-local"
      }
    ],
    "final": "agh-local",
    "optimistic": true,
    "strategy": "prefer_ipv4"
  },
  "inbounds": [],
  "route": {
    "default_http_client": "s-download",
    "default_domain_resolver": "agh-local",
    "rule_set": [
      {
        "tag": [
          "block",
          "direct",
          "proxy"
        ],
        "type": "local",
        "format": "source",
        "path": "./rules/local/{tag}.json"
      },
      {
        "type": "remote",
        "tag": ["geoip/ru"],
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/{tag}.srs",
        "update_interval": "24h",
        "path": "./rules/remote/{tag}.srs"
      },
      {
        "tag": "zapret-ru",
        "type": "local",
        "format": "binary",
        "path": "./rules/local/zapret-ru-domains.srs"
      }
    ],
    "rules": [
      {
        "process_name": [
          "AdGuardHome",
          "adguardhome"
        ],
        "outbound": "direct"
      },
      {
        "action": "resolve",
        "strategy": "prefer_ipv4"
      },
      {
        "action": "sniff",
        "timeout": "1s"
      },
      {
        "action": "sniff-override-destination"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          { "port": 53 },
          { "protocol": "dns" }
        ],
        "action": "hijack-dns"
      },
      { "clash_mode": "Global", "action": "route", "outbound": "Proxy" },
      { "clash_mode": "Direct", "action": "route", "outbound": "direct" },
      { "rule_set": "proxy", "action": "route", "outbound": "Proxy" },
      { "rule_set": "direct", "action": "route", "outbound": "direct" },
      {
        "protocol": [
          "bittorrent"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          "local",
          "lan"
        ],
        "outbound": "direct-out"
      },
      {
        "action": "resolve",
        "match_only": true,
        "strategy": "prefer_ipv4",
        "server": "agh-local"
      },
      {
        "rule_set": [
          "geoip/ru",
          "zapret-ru"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      }
    ],
    "find_process": true,
    "auto_detect_interface": true,
    "final": "Proxy"
  }
}
