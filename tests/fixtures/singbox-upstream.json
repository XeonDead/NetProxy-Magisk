{
  "$schema": "https://raw.githubusercontent.com/reF1nd/sing-box/reF1nd-testing-next/docs/schema.json",
  "log": {
    "disabled": false,
    "level": "warn",
    "output": "/data/adb/modules/netproxy/logs/sing-box.log",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/data/adb/modules/netproxy/config/singbox/cache.db"
    },
    "clash_api": {
      "default_mode": "Rule",
      "external_controller": "127.0.0.1:9999",
      "secret": "singbox",
      "external_ui": "/data/adb/modules/netproxy/webroot/zashboard",
      "external_ui_download_url": "https://github.com/MetaCubeX/metacubexd/releases/download/latest/compressed-dist.tgz"
    }
  },
  "services": [
    {
      "type": "api",
      "listen": "127.0.0.1",
      "listen_port": 9090,
      "secret": "singbox",
      "dashboard": {
        "enabled": true,
        "path": "/data/adb/modules/netproxy/webroot/sing-box-dashboard",
        "http_client": "s-download"
      }
    }
  ],
  "http_clients": [
    {
      "tag": "s-download",
      "detour": "Proxy"
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "dns-proxy",
        "type": "group",
        "servers": [
          "ali",
          "google",
          "adguard"
        ]
      },
      {
        "tag": "dns-direct",
        "type": "group",
        "servers": [
          "yandex",
          "adguard"
        ]
      },
      {
        "type": "hosts",
        "tag": "hosts",
        "predefined": {
          "dns.yandex": [
            "77.88.8.8",
            "77.88.8.1"
          ],
          "dns.google": [
            "8.8.8.8",
            "8.8.4.4"
          ],
          "dns.alidns.com": [
            "223.5.5.5",
            "223.6.6.6"
          ],
          "dns.adguard.com": [
            "94.140.14.14",
            "94.140.15.15"
          ]
        }
      },
      {
        "tag": "yandex",
        "type": "https",
        "server": "dns.yandex",
        "domain_resolver": "hosts"
      },
      {
        "tag": "google",
        "type": "https",
        "server": "dns.google",
        "domain_resolver": "hosts",
        "detour": "Proxy"
      },
      {
        "tag": "ali",
        "type": "https",
        "server": "dns.alidns.com",
        "domain_resolver": "hosts"
      },
      {
        "tag": "adguard",
        "type": "https",
        "server": "dns.adgaurd.com",
        "domain_resolver": "hosts"
      },
      {
        "tag": "malw-hosts",
        "type": "hosts",
        "path": [
          "./rules/local/malw-dns.hosts"
        ]
      }
    ],
    "rules": [
      {
        "action": "evaluate",
        "server": "malw-hosts"
      },
      {
        "match_response": true,
        "ip_accept_any": true,
        "action": "respond"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "dns-direct"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "server": "dns-proxy"
      },
      {
        "rule_set": [
          "direct"
        ],
        "action": "route",
        "server": "dns-direct"
      },
      {
        "rule_set": [
          "proxy"
        ],
        "action": "route",
        "server": "dns-proxy"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "AllowAds",
            "invert": true
          },
          {
            "rule_set": [
              "block",
              "hagezi-pro-adlist"
            ]
          }
        ],
        "action": "reject"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "remote"
      }
    ],
    "final": "dns-proxy",
    "optimistic": true,
    "strategy": "prefer_ipv4"
  },
  "inbounds": [],
  "route": {
    "default_http_client": "s-download",
    "default_domain_resolver": "dns-direct",
    "rule_set": [
      {
        "tag": [
          "block",
          "direct",
          "proxy"
        ],
        "type": "local",
        "format": "source",
        "path": "./rules/local/{tag}.json"
      },
      {
        "type": "remote",
        "tag": ["geosite/ru", "geoip/ru"],
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/{tag}.srs",
        "update_interval": "24h",
        "path": "./rules/remote/{tag}.srs"
      },
      {
        "tag": "zapret-ru",
        "type": "local",
        "format": "binary",
        "path": "./rules/local/zapret-ru-domains.srs"
      }
    ],
    "rules": [
      {
        "action": "resolve",
        "strategy": "prefer_ipv4"
      },
      {
        "action": "sniff",
        "timeout": "1s"
      },
      {
        "action": "sniff-override-destination"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          { "port": 53 },
          { "protocol": "dns" }
        ],
        "action": "hijack-dns"
      },
      { "clash_mode": "Global", "action": "route", "outbound": "Proxy" },
      { "clash_mode": "Direct", "action": "route", "outbound": "direct" },
      { "rule_set": "proxy", "action": "route", "outbound": "Proxy" },
      { "rule_set": "direct", "action": "route", "outbound": "direct" },
      {
        "protocol": [
          "bittorrent"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          "local",
          "lan"
        ],
        "outbound": "direct-out"
      },
      {
        "action": "resolve",
        "match_only": true,
        "strategy": "prefer_ipv4",
        "server": "agh-local"
      },
      {
        "rule_set": [
          "geoip/ru",
          "geosite/ru",
          "zapret-ru"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      }
    ],
    "find_process": true,
    "auto_detect_interface": true,
    "final": "Proxy"
  }
}